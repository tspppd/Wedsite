// Prisma Schema for WedSite
// Database: Supabase (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// User Profile (extends Supabase auth.users)
model Profile {
  id        String   @id @db.Uuid
  name      String
  email     String   @unique
  role      Role     @default(USER)
  plan      Plan     @default(FREE)
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  weddingSites WeddingSite[]
  payments     Payment[]

  @@map("profiles")
}

// Wedding Website
model WeddingSite {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  title         String
  slug          String   @unique
  template      String   @default("classic")
  customDomain  String?  @unique @map("custom_domain")
  isPublished   Boolean  @default(false) @map("is_published")
  themeColors   Json     @default("{}") @map("theme_colors") @db.JsonB
  sections      Json     @default("[]") @map("sections") @db.JsonB
  settings      Json     @default("{}") @map("settings") @db.JsonB
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  user      Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  rsvps     RsvpResponse[]
  analytics Analytics[]

  @@index([userId])
  @@index([slug])
  @@map("wedding_sites")
}

// RSVP Response
model RsvpResponse {
  id                  String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  weddingSiteId       String           @map("wedding_site_id") @db.Uuid
  guestName           String           @map("guest_name")
  guestEmail          String?          @map("guest_email")
  guestPhone          String?          @map("guest_phone")
  attendanceStatus    AttendanceStatus @map("attendance_status")
  numberOfGuests      Int              @default(1) @map("number_of_guests")
  dietaryRequirements String?          @map("dietary_requirements")
  message             String?
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  weddingSite WeddingSite @relation(fields: [weddingSiteId], references: [id], onDelete: Cascade)

  @@index([weddingSiteId])
  @@map("rsvp_responses")
}

// Payment
model Payment {
  id            String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("THB")
  status        PaymentStatus
  plan          Plan
  paymentMethod String?       @map("payment_method")
  transactionId String?       @unique @map("transaction_id")
  metadata      Json          @default("{}") @db.JsonB
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("payments")
}

// Analytics
model Analytics {
  id            String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  weddingSiteId String      @map("wedding_site_id") @db.Uuid
  eventType     String      @map("event_type")
  eventData     Json        @default("{}") @map("event_data") @db.JsonB
  ipAddress     String?     @map("ip_address")
  userAgent     String?     @map("user_agent")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  weddingSite WeddingSite @relation(fields: [weddingSiteId], references: [id], onDelete: Cascade)

  @@index([weddingSiteId])
  @@map("analytics")
}

// Enums
enum Role {
  USER  @map("user")
  ADMIN @map("admin")
}

enum Plan {
  FREE @map("free")
  PRO  @map("pro")
}

enum AttendanceStatus {
  ATTENDING     @map("attending")
  NOT_ATTENDING @map("not_attending")
  MAYBE         @map("maybe")
}

enum PaymentStatus {
  PENDING   @map("pending")
  COMPLETED @map("completed")
  FAILED    @map("failed")
  REFUNDED  @map("refunded")
}
