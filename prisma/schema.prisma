generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?   @map("image") // สำหรับเก็บ Avatar
  role          String?   @default("user") // จำเป็นสำหรับ Admin Plugin
  plan          Plan      @default(FREE)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relationships
  sessions      Session[]
  accounts      Account[]
  weddingSites  WeddingSite[]
  payments      Payment[]

  @@map("profiles")
}

model WeddingSite {
  id           String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  title        String
  slug         String         @unique
  template     String         @default("classic")
  customDomain String?        @unique @map("custom_domain")
  isPublished  Boolean        @default(false) @map("is_published")
  themeColors  Json           @default("{}") @map("theme_colors")
  sections     Json           @default("[]") @map("sections")
  settings     Json           @default("{}") @map("settings")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  analytics    Analytics[]
  rsvps        RsvpResponse[]
  user         Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([slug])
  @@map("wedding_sites")
}

model RsvpResponse {
  id                  String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  weddingSiteId       String           @map("wedding_site_id") @db.Uuid
  guestName           String           @map("guest_name")
  guestEmail          String?          @map("guest_email")
  guestPhone          String?          @map("guest_phone")
  attendanceStatus    AttendanceStatus @map("attendance_status")
  numberOfGuests      Int              @default(1) @map("number_of_guests")
  dietaryRequirements String?          @map("dietary_requirements")
  message             String?
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  weddingSite         WeddingSite      @relation(fields: [weddingSiteId], references: [id], onDelete: Cascade)

  @@index([weddingSiteId])
  @@map("rsvp_responses")
}

model Payment {
  id            String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("THB")
  status        PaymentStatus
  plan          Plan
  paymentMethod String?       @map("payment_method")
  transactionId String?       @unique @map("transaction_id")
  metadata      Json          @default("{}")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  user          Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("payments")
}

model Analytics {
  id            String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  weddingSiteId String      @map("wedding_site_id") @db.Uuid
  eventType     String      @map("event_type")
  eventData     Json        @default("{}") @map("event_data")
  ipAddress     String?     @map("ip_address")
  userAgent     String?     @map("user_agent")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  weddingSite   WeddingSite @relation(fields: [weddingSiteId], references: [id], onDelete: Cascade)

  @@index([weddingSiteId])
  @@map("analytics")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  profile   Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

enum Role {
  USER  @map("user")
  ADMIN @map("admin")
}

enum Plan {
  FREE @map("free")
  PRO  @map("pro")
}

enum AttendanceStatus {
  ATTENDING     @map("attending")
  NOT_ATTENDING @map("not_attending")
  MAYBE         @map("maybe")
}

enum PaymentStatus {
  PENDING   @map("pending")
  COMPLETED @map("completed")
  FAILED    @map("failed")
  REFUNDED  @map("refunded")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  profile               Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?   // สำหรับ Email/Password Login
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}
